<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ScreenLossless</AssemblyName>
    <RootNamespace>ScreenLossless</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(StandaloneToolsArchive)' != ''">true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>..\assets\ScreenLossless.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(StandaloneToolsArchive)' != ''">
    <EmbeddedResource Include="$(StandaloneToolsArchive)" LogicalName="ScreenLossless.Tools.zip" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization/en.json" LogicalName="ScreenLossless.Localization.en.json" />
    <EmbeddedResource Include="..\assets\ScreenLossless.ico" LogicalName="ScreenLossless.AppIcon" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
</Project>
